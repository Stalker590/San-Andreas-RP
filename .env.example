# =============================================================================
#  SAN ANDREAS RP — Шаблон конфигурации окружения (.env.example)
#  Скопируйте этот файл в .env перед запуском: cp .env.example .env
#  ВНИМАНИЕ: Файл .env содержит секреты и исключён из Git (.gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
#  1. СУБД MariaDB 10.11+ / MySQL 8.0+ (асинхронный пул BlueG MySQL R41-4)
#  При запуске через Docker Compose используйте MYSQL_HOST=db.
#  При локальном запуске на хосте без Docker используйте MYSQL_HOST=127.0.0.1.
# -----------------------------------------------------------------------------
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=san_andreas_rp
MYSQL_USER=sarp_server
MYSQL_PASSWORD=sarp_local_dev_password_2026
MYSQL_ROOT_PASSWORD=sarp_root_local_dev_2026
MYSQL_CHARSET=cp1251
MYSQL_POOL_SIZE=12

# -----------------------------------------------------------------------------
#  2. Игровой сервер open.mp v1.6.7+ (динамическая подстановка в config.json)
# -----------------------------------------------------------------------------
OMP_SERVER_NAME=SAN ANDREAS RP | English Roleplay
OMP_LANGUAGE=English
OMP_MAX_PLAYERS=500
OMP_PORT=7777
OMP_BIND_ADDRESS=0.0.0.0
OMP_RCON_ENABLE=false
OMP_RCON_PASSWORD=change_rcon_secret_in_production
OMP_ANNOUNCE=false
OMP_ENABLE_QUERY=true
OMP_SERVER_PASSWORD=
OMP_WEBSITE=
OMP_DISCORD_INVITE=

# -----------------------------------------------------------------------------
#  3. Безопасность и резервное копирование (deploy/backup_mysql.sh)
# -----------------------------------------------------------------------------
BCRYPT_COST=12
SARP_BACKUP_DIR=/backups
SARP_BACKUP_RETENTION_DAYS=14
